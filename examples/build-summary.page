::page id=build-summary title="Build summary"
  ::import from="stdlib/data.page"
  ::/import

  ::el tag=main
    ::hero heading="Build summary"
      body="Example CI run for the search API."
    ::/hero

    ::section
      ::grid columns=2
        ::use recipe=metric-card id=checks label="Checks passed" value="28 / 28" tone=default
        ::/use
        ::use recipe=metric-card id=duration label="Duration" value="2m 18s" tone=default
        ::/use
        ::use recipe=metric-card id=coverage label="Line coverage" value="87%" tone=default
        ::/use
        ::use recipe=metric-card id=artifact label="Artifact size" value="6.4 MB" tone=default
        ::/use
      ::/grid
    ::/section
  ::/el

  ::style scope=page
    body { background: #fbfcfe; color: #182c4b; font-family: system-ui, sans-serif; }
    .ps-container { width: min(660px, calc(100% - 36px)); }
    .ps-hero { display: block; min-height: 0; padding: 24px 0 0; }
    .ps-hero-inner { gap: 8px; }
    .ps-hero h1 { max-width: none; font-size: clamp(28px, 7vw, 48px); }
    .ps-section { padding: 20px 0 24px; }
    .ps-section .ps-grid { gap: 12px; }
    .ps-section .ps-card { min-width: 0; padding: 12px; border: 1px solid #becddd; border-radius: 8px; background: #edf3f9; box-shadow: none; transform: none; }
    .ps-metric > span { color: #3a5b8a; font-size: .85rem; font-weight: 600; }
    .ps-metric > strong { font-size: clamp(20px, 5vw, 30px); font-weight: 800; font-variant-numeric: tabular-nums; }
    .ps-reveal { opacity: 1; transform: none; transition: none; }
  ::/style
::/page
